{
  "name": "temporary-chat-enforcer",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-enables native temporary/incognito chat mode on ChatGPT, Claude, Gemini, Grok, and Perplexity.",
  "homepage": "https://github.com/sohhamm/temporary-chat-enforcer",
  "license": "MIT",
  "author": "Super Collective <support@supercollective.studio>",
  "repository": "github:sohhamm/temporary-chat-enforcer",
  "type": "module",
  "scripts": {
    "dev": "WXT_MANUAL_BROWSER=1 wxt",
    "dev:chrome:managed": "CHROME_PROFILE= wxt",
    "dev:comet": "mkdir -p .wxt/comet-profile && COMET_PROFILE=\"$PWD/.wxt/comet-profile\" wxt -b comet",
    "dev:comet:profile": "COMET_PROFILE=\"$HOME/Library/Application Support/Comet\" wxt -b comet",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "bun check --no-script",
    "lint": "bun lint --no-script --type-aware --type-check -c .oxlintrc.json",
    "lint:fix": "bun lint --no-script --type-aware --type-check -c .oxlintrc.json --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun fmt --check && bun run lint",
    "fix": "bun fmt && bun run lint:fix",
    "test": "bun test --parallel --randomize",
    "test:watch": "bun test --watch",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/chrome": "^0.3.8",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "node-forge@<1.4.3": "1.4.3"
  },
  "engines": {
    "bun": ">=1.4.5",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild"
  ]
}
