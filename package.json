{
  "name": "temporary-chat-enforcer",
  "description": "Auto-enables native temporary/incognito chat mode on supported LLM web apps.",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "author": "Soham Sarkar",
  "type": "module",
  "scripts": {
    "dev": "WXT_MANUAL_BROWSER=1 wxt",
    "dev:chrome:managed": "CHROME_PROFILE= wxt",
    "dev:comet": "mkdir -p .wxt/comet-profile && COMET_PROFILE=\"$PWD/.wxt/comet-profile\" wxt -b comet",
    "dev:comet:profile": "COMET_PROFILE=\"$HOME/Library/Application Support/Comet\" wxt -b comet",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
