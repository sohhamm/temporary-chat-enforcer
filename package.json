{
  "name": "temporary-chat-enforcer",
  "description": "Auto-enables native temporary/incognito chat mode on supported LLM web apps.",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "author": "Soham Sarkar",
  "type": "module",
  "scripts": {
    "dev": "WXT_MANUAL_BROWSER=1 wxt",
    "dev:chrome:managed": "CHROME_PROFILE= wxt",
    "dev:comet": "mkdir -p .wxt/comet-profile && COMET_PROFILE=\"$PWD/.wxt/comet-profile\" wxt -b comet",
    "dev:comet:profile": "COMET_PROFILE=\"$HOME/Library/Application Support/Comet\" wxt -b comet",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
